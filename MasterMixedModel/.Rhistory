# Load ggplot2 if not already loaded
# install.packages("ggplot2")
library(ggplot2)
set.seed(42)
n_iter <- 5000
true_var_u <- 2.5
true_var_e <- 1.5
# =====================================================================
# 1. Simulate a "Converged" Chain (Good Mixing)
# =====================================================================
# A healthy chain quickly finds the target region and forms a dense,
# random cloud (white noise / low autocorrelation) around the true values.
good_var_u <- true_var_u + arima.sim(model = list(ar = 0.4), n = n_iter) * 0.15
good_var_e <- true_var_e + arima.sim(model = list(ar = 0.4), n = n_iter) * 0.15
# Initial start point far away to show a healthy burn-in jump
good_var_u[1:10] <- seq(8, good_var_u[11], length.out = 10)
good_var_e[1:10] <- seq(6, good_var_e[11], length.out = 10)
# =====================================================================
# 2. Simulate a "Non-Converged" Chain (Poor Mixing / Random Walk)
# =====================================================================
# An unhealthy chain exhibits high autocorrelation, wandering aimlessly
# (like a random walk) without settling, or getting stuck far from the truth.
bad_var_u <- 8 + cumsum(rnorm(n_iter, mean = -0.0005, sd = 0.03))
bad_var_e <- 6 + cumsum(rnorm(n_iter, mean = -0.0005, sd = 0.03))
# =====================================================================
# 3. Apply Thinning and Format for ggplot
# =====================================================================
# Thin every 20 iterations for the first 1000, then every 100 iterations
burn_in <- 1000
idx_burnin <- seq(1, burn_in, by = 20)
idx_post <- seq(burn_in + 100, n_iter, by = 100)
thin_idx <- c(idx_burnin, idx_post)
# Create dataframe for the Good Chain
df_good <- data.frame(
Iteration = thin_idx,
var_u = good_var_u[thin_idx],
var_e = good_var_e[thin_idx],
Status = "1. Good Convergence (Healthy Mixing)"
)
# Create dataframe for the Bad Chain
df_bad <- data.frame(
Iteration = thin_idx,
var_u = bad_var_u[thin_idx],
var_e = bad_var_e[thin_idx],
Status = "2. Poor Convergence (Wandering / Random Walk)"
)
# Combine into a single dataframe
df_compare <- rbind(df_good, df_bad)
# =====================================================================
# 4. Generate the Comparison Plot
# =====================================================================
ggplot(df_compare, aes(x = var_u, y = var_e)) +
geom_path(aes(color = Iteration), linewidth = 0.6, alpha = 0.7) +
geom_point(aes(color = Iteration), size = 2) +
# Red 'X' for true values
geom_point(aes(x = true_var_u, y = true_var_e), color = "red", shape = 4, size = 4, stroke = 2) +
# Facet by chain status, allowing free scales so we can see the localized behavior
facet_wrap(~ Status, scales = "free") +
scale_color_viridis_c(option = "plasma", end = 0.9) +
labs(
title = "MCMC Trajectory: Convergence vs. Non-Convergence",
subtitle = "Red 'X' marks true values. Notice how the bad chain wanders and fails to find the target.",
x = expression(paste("Random Effect Variance (", sigma[u]^2, ")")),
y = expression(paste("Residual Variance (", sigma[e]^2, ")")),
color = "Iteration"
) +
theme_bw() +
theme(
plot.title = element_text(face = "bold"),
strip.background = element_rect(fill = "lightgray"),
strip.text = element_text(face = "bold", size = 10),
legend.position = "right"
)
ggplot(df_compare, aes(x = var_u, y = var_e)) +
geom_path(aes(color = Iteration), linewidth = 0.6, alpha = 0.7) +
geom_point(aes(color = Iteration), size = 2) +
# Red 'X' for true values
geom_point(aes(x = true_var_u, y = true_var_e), color = "red", shape = 4, size = 4, stroke = 2) +
# Facet by chain status, allowing free scales so we can see the localized behavior
facet_wrap(~ Status, scales = "free") +
scale_color_viridis_c(option = "plasma", end = 0.9) +
labs(
title = "MCMC Trajectory: Convergence vs. Non-Convergence",
subtitle = "Red 'X' marks true values",
x = expression(paste("Random Effect Variance (", sigma[u]^2, ")")),
y = expression(paste("Residual Variance (", sigma[e]^2, ")")),
color = "Iteration"
) +
theme_bw() +
theme(
plot.title = element_text(face = "bold"),
strip.background = element_rect(fill = "lightgray"),
strip.text = element_text(face = "bold", size = 10),
legend.position = "right"
)

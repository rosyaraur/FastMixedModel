set.seed(123)
N <- 200        # Number of observations
q <- 20         # Number of random effects (e.g., number of breeding lines)
# Fixed effects design (Intercept + 1 covariate)
X <- cbind(1, rnorm(N, mean = 10, sd = 2))
beta_true <- c(5.5, 2.0)
# Random effects design
Z <- matrix(rnorm(N * q), ncol = q)
var_u_true <- 2.5
u_true <- rnorm(q, mean = 0, sd = sqrt(var_u_true))
# Residuals and Final Response
var_e_true <- 1.5
e <- rnorm(N, mean = 0, sd = sqrt(var_e_true))
y <- X %*% beta_true + Z %*% u_true + e
# =====================================================================
# 2. The Block Gibbs MCMC Sampler
# =====================================================================
mcmc_mixed_model <- function(y, X, Z, n_iter = 5000, burn_in = 1000) {
# Setup Dimensions
N <- nrow(X)
p <- ncol(X)
q <- ncol(Z)
W <- cbind(X, Z)
# Pre-compute cross products for speed (similar to C++ MtM and Mty)
WtW <- crossprod(W)
Wty <- crossprod(W, y)
# Priors: Scaled Inverse Chi-Square (Weakly informative)
nu_e <- 4; S_e <- var(y) * 0.5
nu_u <- 4; S_u <- var(y) * 0.1
# Initialize Storage Chains
chain_var_e <- numeric(n_iter)
chain_var_u <- numeric(n_iter)
chain_beta  <- matrix(0, nrow = n_iter, ncol = p)
# Initial starting values (The "Start Point" of the wanderer)
var_e <- as.numeric(var(y))
var_u <- as.numeric(var(y) / 10)
# Begin MCMC Loop
for (i in 1:n_iter) {
# --- STEP A: Sample Effects (beta, u) ---
# 1. Build the penalty matrix (Henderson's D_inv)
lambda <- var_e / var_u
D_inv <- diag(c(rep(0, p), rep(lambda, q)))
# 2. Build Coefficient Matrix C
C <- WtW + D_inv
# 3. Find the MAP estimate (the mean of the multivariate normal)
mean_theta <- solve(C, Wty)
# 4. Draw the Multivariate Sample using Cholesky factorization
# Note: R's chol() returns upper triangular U where U'U = C
U <- chol(C)
z <- rnorm(p + q) # Standard normal noise
# The actual Gibbs draw: theta = mean + U^(-1) * z * sqrt(var_e)
theta_sample <- mean_theta + backsolve(U, z) * sqrt(var_e)
beta <- theta_sample[1:p]
u    <- theta_sample[(p + 1):(p + q)]
# --- STEP B: Sample Residual Variance (var_e) ---
res <- y - X %*% beta - Z %*% u
df_e <- N + nu_e
scale_e <- crossprod(res) + nu_e * S_e
var_e <- as.numeric(scale_e / rchisq(1, df_e))
# --- STEP C: Sample Random Effect Variance (var_u) ---
df_u <- q + nu_u
scale_u <- crossprod(u) + nu_u * S_u
var_u <- as.numeric(scale_u / rchisq(1, df_u))
# --- Store the results ---
chain_var_e[i] <- var_e
chain_var_u[i] <- var_u
chain_beta[i, ] <- beta
}
return(list(
var_e = chain_var_e,
var_u = chain_var_u,
beta = chain_beta,
burn_in = burn_in,
n_iter = n_iter
))
}
# =====================================================================
# 3. Execute Model and Generate Faceted Trace Plots
# =====================================================================
# Install necessary plotting packages if you haven't already:
# install.packages(c("ggplot2", "tidyr"))
library(ggplot2)
library(tidyr)
# Run the sampler using the simulated data
results <- mcmc_mixed_model(y, X, Z, n_iter = 5000, burn_in = 1000)
# Create an index to sample every 100th iteration (including the burn-in period)
thin_idx <- seq(1, results$n_iter, by = 100)
# Build a dataframe combining the iteration numbers with their sampled values
trace_df <- data.frame(
Iteration = thin_idx,
var_e = results$var_e[thin_idx],
var_u = results$var_u[thin_idx],
beta_0 = results$beta[thin_idx, 1],
beta_1 = results$beta[thin_idx, 2]
)
# Convert the dataframe to a "long" format for ggplot faceting
trace_long <- pivot_longer(
trace_df,
cols = c(var_e, var_u, beta_0, beta_1),
names_to = "Parameter",
values_to = "Value"
)
# Rename the parameters for cleaner facet titles
facet_labels <- c(
"var_e" = "Residual Variance (var_e)",
"var_u" = "Random Effect Variance (var_u)",
"beta_0" = "Intercept (beta_0)",
"beta_1" = "Slope (beta_1)"
)
trace_long$Parameter <- factor(trace_long$Parameter, levels = names(facet_labels), labels = facet_labels)
# Create a reference dataframe for the true simulated values
true_values <- data.frame(
Parameter = factor(names(facet_labels), levels = names(facet_labels), labels = facet_labels),
True_Value = c(1.5, 2.5, 5.5, 2.0)
)
# Generate the 4-facet plot
ggplot(trace_long, aes(x = Iteration, y = Value)) +
# Add the connected lines and points
geom_line(color = "gray60", linewidth = 0.5) +
geom_point(color = "steelblue", size = 2) +
# Add a red dashed line representing the true simulation value
geom_hline(data = true_values, aes(yintercept = True_Value),
color = "red", linetype = "dashed", linewidth = 0.8) +
# Add a dotted vertical line separating burn-in from the active sampling phase
geom_vline(xintercept = results$burn_in,
color = "black", linetype = "dotted", linewidth = 1) +
# Create 4 panels with independent y-axes
facet_wrap(~ Parameter, scales = "free_y", ncol = 2) +
# Formatting and labels
labs(
title = "MCMC Trace Plots ",
subtitle = "",
x = "Iteration Number",
y = "Sampled Value"
) +
theme_bw() +
theme(
strip.background = element_rect(fill = "lightgray"),
strip.text = element_text(face = "bold", size = 10)
)
